NODE_ENV=development
PORT=4100

# Standing bridge room the on-call joins during incidents.
BRIDGE_MEETING_URL=https://meet.google.com/xxx-xxxx-xxx

# Forward PagerDuty-triggered incidents to the bridge assistant (optional).
INCIDENT_COPILOT_URL=

# Shared bearer token for /internal/pagerduty/trigger and assistant forwarding.
INCIDENT_REPORT_TOKEN=dev-report-token

# Optional override; defaults to this checkout's working directory.
CODEBASE_PATH=

# PagerDuty Events API v2 routing key (integration key).
PAGERDUTY_ROUTING_KEY=

# PagerDuty webhook subscription secret (X-PagerDuty-Signature).
PAGERDUTY_WEBHOOK_SECRET=

# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
