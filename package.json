{
    "name": "acme-checkout",
    "version": "0.1.0",
    "private": true,
    "description": "Acme Checkout — payments, inventory, and PagerDuty incident notifications.",
    "type": "module",
    "engines": {
        "node": ">=20.11"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "smoke": "tsx src/index.ts --smoke",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "report-incident": "tsx scripts/report_incident.ts"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.5",
        "@types/supertest": "^6.0.2",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vitest": "^2.1.8"
    }
}
